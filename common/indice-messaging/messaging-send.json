            ]
          },
          "recipientIds": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            }
          },
          "recipients": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ContactAnonymous"
            }
          },
          "isGlobal": {
            "type": "boolean"
          },
          "title": {
            "type": "string"
          },
          "content": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/MessageContent"
            }
          },
          "actionLink": {
