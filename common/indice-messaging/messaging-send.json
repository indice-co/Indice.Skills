            ]
          },
          "messageTemplateChannels": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MessageChannelKind"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "oauth2": {
        "type": "oauth2",
        "description": "Identity Server OAuth2",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "https://my.indice.gr/connect/token",
            "scopes": {
              "messages": "Access to Messaging API",
              "media": "API for media library."
            }
          },
          "authorizationCode": {
            "authorizationUrl": "https://my.indice.gr/connect/authorize",
            "tokenUrl": "https://my.indice.gr/connect/token",
            "refreshUrl": "https://my.indice.gr/connect/token",
            "scopes": {
              "messages": "Access to Messaging API",
              "media": "API for media library."
            }
          }
        }
      }
    }
