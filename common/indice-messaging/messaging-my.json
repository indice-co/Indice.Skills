          "search": {
            "type": [
              "null",
              "string"
            ]
          },
          "typeId": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "activeFrom": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "activeTo": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
